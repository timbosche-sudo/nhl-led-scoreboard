{
  "name": "nhl-led-scoreboard",
  "private": true,
  "version": "0.1.0",
  "description": "Pixel-accurate NHL LED scoreboard simulator (128x32 RGB matrix) with a path to Raspberry Pi hardware.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "serve": "node server/server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "render": "tsx scripts/render-frames.ts",
    "fetch-logos": "node scripts/fetch-logos.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
